{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omnician",
  "compatibility_date": "2026-09-28",
  "main": "worker/index.ts",
  // SPA assets plus /api/factory on the same Worker. FACTORY is the
  // omnician-factory KV namespace that stores the live Drums library.
  "kv_namespaces": [
    {
      "binding": "FACTORY",
      "id": "04a8387cddbc4f50993dba65cea13681",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    // Static /rhythm files would otherwise skip the User Worker and omit CORS
    // for the native webview. /api/* already misses the asset graph.
    "run_worker_first": ["/api/*", "/rhythm/*"],
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  // Attached on the first real `npm run deploy`. Do not add a CNAME for these
  // hostnames first — Custom Domains create the DNS records themselves.
  "routes": [
    { "pattern": "omnician.app", "custom_domain": true },
    { "pattern": "www.omnician.app", "custom_domain": true },
  ],
}
