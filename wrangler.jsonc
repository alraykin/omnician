{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omnician",
  "compatibility_date": "2026-09-28",
  "main": "worker/index.ts",
  // SPA assets plus /api/factory on the same Worker. Create a KV namespace
  // named omnician-factory and replace this placeholder id before deploy.
  "kv_namespaces": [
    {
      "binding": "FACTORY",
      "id": "00000000000000000000000000000000",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  // Attached on the first real `npm run deploy`. Do not add a CNAME for these
  // hostnames first — Custom Domains create the DNS records themselves.
  "routes": [
    { "pattern": "omnician.app", "custom_domain": true },
    { "pattern": "www.omnician.app", "custom_domain": true },
  ],
}
