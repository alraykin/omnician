{
  "headers": [
    {
      "source": "/worklets/pitch-processor.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/tuner", "destination": "/index.html" },
    { "source": "/tuner/", "destination": "/index.html" },
    { "source": "/rhythm", "destination": "/index.html" },
    { "source": "/rhythm/", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
