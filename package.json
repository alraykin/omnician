{
  "name": "omnician",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:pitch": "npx --yes tsx scripts/pitch-accuracy.ts",
    "test:tempo": "npx --yes tsx scripts/tempo-accuracy.ts",
    "test:intensity": "npx --yes tsx scripts/intensity-loudness.ts && npx --yes tsx scripts/measure-intensity-loudness.ts --assert",
    "test:sticky": "npx --yes tsx scripts/sticky-tune.ts",
    "test:calibration": "npx --yes tsx scripts/tuner-calibration.ts",
    "test:accuracy": "npx --yes tsx scripts/tuner-accuracy.ts",
    "test:a4": "npx --yes tsx scripts/a4-reference.ts",
    "test:note-freq": "npx --yes tsx scripts/note-frequencies.ts",
    "test:scheduler": "npx --yes tsx scripts/scheduler-after-preview.ts",
    "test:recorder": "npx --yes tsx scripts/drum-recorder.ts",
    "test:hold-repeat": "npx --yes tsx scripts/hold-repeat.ts",
    "test:user-beats": "npx --yes tsx scripts/user-beats.ts",
    "test:midi-import": "npx --yes tsx scripts/midi-import.ts",
    "test:beat-boxes": "npx --yes tsx scripts/beat-boxes.ts",
    "test:auto-complete": "npx --yes tsx scripts/auto-complete.ts",
    "test:ghost-notes": "npx --yes tsx scripts/ghost-notes.ts",
    "test:move-hit": "npx --yes tsx scripts/move-hit.ts",
    "test:meter-input": "npx --yes tsx scripts/meter-input.ts",
    "test:hat-choke": "npx --yes tsx scripts/hat-choke.ts",
    "test:legal": "npx --yes tsx scripts/legal-markdown.ts",
    "test:chameleon": "npx --yes tsx scripts/chameleon.ts",
    "test:factory": "npx --yes tsx scripts/factory-library.ts",
    "test:sound-sources": "npx --yes tsx scripts/sound-sources.ts",
    "test:reference-tone": "npx --yes tsx scripts/reference-tone.ts",
    "test:audio-session": "npx --yes tsx scripts/audio-session.ts",
    "test:ios-prep": "npx --yes tsx scripts/ios-prep.ts",
    "test:click-subdivision": "npx --yes tsx scripts/click-subdivision.ts",
    "test:drum-editor": "npx --yes tsx scripts/drum-editor.ts",
    "test:click-presets": "npx --yes tsx scripts/click-presets.ts",
    "test:drum-history": "npx --yes tsx scripts/drum-history.ts",
    "test:bpm-wheel": "npx --yes tsx scripts/bpm-wheel.ts",
    "test:master-peaks": "npx --yes tsx scripts/master-peaks.ts",
    "test:tuner-layout": "npx --yes tsx scripts/tuner-layout.ts",
    "test:fold": "npx --yes tsx scripts/fold-mode.ts",
    "test:pendulum": "npx --yes tsx scripts/pendulum-swing.ts",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy-cloudflare.sh",
    "ios:icons": "node scripts/generate-ios-icons.mjs",
    "ios:sync": "npm run build && npx cap sync ios && npx --yes tsx scripts/ios-prep.ts",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "pitchy": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "description": "Omnician — the ultimate practice companion"
}
